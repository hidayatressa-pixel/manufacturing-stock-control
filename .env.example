# Application mode is selected server-side and cannot be changed by a browser request.
APP_MODE=demo
PORT=4000
WEB_ORIGIN=http://localhost:5173
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-characters

# Demo and production must use separate MySQL databases and users.
MSC_DEMO_DATABASE_URL=mysql://msc_demo_user:password@localhost:3306/msc_demo
DATABASE_URL=mysql://msc_app_user:password@localhost:3306/msc_production

# One-time production bootstrap. Remove after the first Admin is created.
ADMIN_BOOTSTRAP_TOKEN=replace-before-production-initialization
